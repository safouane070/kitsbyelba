# KitsbyElba — Security & Performance Headers

<IfModule mod_headers.c>
    # Prevent clickjacking (embedding in iframes on other sites)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Control referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Basic XSS protection for older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Restrict browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # CSP: tighten further by moving inline JS to files and dropping 'unsafe-inline'
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self' https://wa.me; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: blob:; connect-src 'self' https://api.emailjs.com; upgrade-insecure-requests"

    # Enforce HTTPS after first secure visit (enable preload only when fully ready)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Prevent directory listing
Options -Indexes

# Run PHP inside the two static entry pages so they can reuse shared includes
# (shared footer/nav). Scoped to ONLY these two files — every other .html stays
# a plain static file. XAMPP/Apache mod_php: handler name is application/x-httpd-php.
<FilesMatch "^(index|shop)\.html$">
    SetHandler application/x-httpd-php
</FilesMatch>

# Force HTML files to always reload fresh (no browser cache)
<FilesMatch "\.(html)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
</FilesMatch>

# Versioned CSS/JS (kits_asset zet ?v=mtime) → 1 jaar immutable: ververst vanzelf zodra 't bestand wijzigt
<FilesMatch "\.(css|js|mjs)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# Afbeeldingen → 30 dagen (niet immutable: kan zonder versie-query vervangen worden)
<FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
    Header always set Cache-Control "public, max-age=2592000"
</FilesMatch>
# Fonts: zelden wisselen — lang cachen (herhaalbezoeken / PageSpeed “cache lifetimes”)
<FilesMatch "\.(woff2?|ttf|otf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Compressie voor tekst-assets (HTML/CSS/JS/JSON/SVG) — woff2 is al gecomprimeerd, dus overgeslagen
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/x-javascript application/json application/xml image/svg+xml application/rss+xml
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/x-javascript application/json application/xml image/svg+xml application/rss+xml
</IfModule>

# Block HTTP access to PHP includes (not used for normal URLs; prevents accidental probing)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (supports direct HTTPS and reverse-proxy TLS via X-Forwarded-Proto)
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  RewriteRule ^includes(/|$) - [F,L]
  # Block HTTP access to CLI/maintenance scripts (run these from the shell only)
  RewriteRule ^tools(/|$) - [F,L]
  # Block version-control metadata (a served .git/ leaks full source + history)
  RewriteRule (^|/)\.(git|hg|svn)(/|$) - [F,L]
  # Block the ROOT config.php (holds DB creds) — but NOT api/config.php, which is
  # the intentionally public, sanitized config endpoint the frontend fetches.
  RewriteRule ^config\.php$ - [F,L]
  # 301: legacy query URLs -> clean category URLs
  RewriteCond %{REQUEST_URI} ^/(index\.html|shop\.html)$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)(type|cat)=shirts(&|$) [NC]
  RewriteRule ^ shirts? [R=301,L]
  RewriteCond %{REQUEST_URI} ^/(index\.html|shop\.html)$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)(type|cat)=sets(&|$) [NC]
  RewriteRule ^ sets? [R=301,L]
  RewriteCond %{REQUEST_URI} ^/(index\.html|shop\.html)$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)(type|cat)=hemdsetjes(&|$) [NC]
  RewriteRule ^ hemdsetjes? [R=301,L]
  RewriteCond %{REQUEST_URI} ^/(index\.html|shop\.html)$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)(type|cat)=retro(&|$) [NC]
  RewriteRule ^ retro? [R=301,L]
  RewriteCond %{REQUEST_URI} ^/(index\.html|shop\.html)$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)(type|cat)=kids(&|$) [NC]
  RewriteRule ^ kids? [R=301,L]
  RewriteCond %{REQUEST_URI} ^/(index\.html|shop\.html)$ [NC]
  RewriteCond %{QUERY_STRING} (^|&)(type|cat)=voorraad(&|$) [NC,OR]
  RewriteCond %{QUERY_STRING} (^|&)voorraad=1(&|$) [NC]
  RewriteRule ^ voorraad? [R=301,L]
  # Category landing pages (real dedicated page files, same shop styling)
  RewriteRule ^shirts/?$ shirts.php [L,QSA,NC]
  RewriteRule ^sets/?$ sets.php [L,QSA,NC]
  RewriteRule ^hemdsetjes/?$ hemdsetjes.php [L,QSA,NC]
  RewriteRule ^retro/?$ retro.php [L,QSA,NC]
  RewriteRule ^kids/?$ kids.php [L,QSA,NC]
  RewriteRule ^voorraad/?$ voorraad.php [L,QSA,NC]
</IfModule>

# Block direct access to sensitive files.
# NOTE: config.php is handled by the mod_rewrite rule above (root-only), so it is
# deliberately NOT listed here — a FilesMatch would also block api/config.php.
<FilesMatch "(\.env|\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
