# Uploaded files are data, never code. Block execution of any server-side script.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
php_flag engine off

# Belt-and-suspenders: refuse to hand back anything executable as a script.
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|asp|aspx|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Only serve images / plain data from here.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
