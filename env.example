# Copy to .env (same folder as config.php). Never commit .env.
# All keys use the KITS_ prefix.

# KITS_DB_HOST=127.0.0.1
# KITS_DB_NAME=kitsbyelba
# KITS_DB_USER=root
# KITS_DB_PASS=

# KITS_PUBLIC_SITE_URL=https://yourdomain.example
# KITS_IMPORT_SECRET=replace-with-long-random-string
# KITS_ADMIN_PASSWORD_HASH=$2y$12$...paste-from-php-tools-set_admin_password.php

# KITS_EMAILJS_PK=
# KITS_EMAILJS_SERVICE=
# KITS_EMAILJS_TEMPLATE_ORDER=
# KITS_EMAILJS_TEMPLATE_PAID=

# Optional: comma-separated extra CORS origins
# KITS_TRUSTED_ORIGINS=https://www.example.com
