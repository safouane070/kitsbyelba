# ============================================================
# KitsbyElba — Production environment variables
# INSTRUCTIONS:
#   1. Copy this file to .env  (same folder)
#   2. Fill in every value below
#   3. Never commit .env to git — it contains secrets
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Create a dedicated DB user in your hosting control panel.
# Do NOT use root in production.
KITS_DB_HOST=127.0.0.1
KITS_DB_NAME=kitsbyelba
KITS_DB_USER=your_db_username
KITS_DB_PASS=your_strong_db_password

# ── Your domain (no trailing slash) ──────────────────────────
# Must match exactly what users type in the browser (https!)
# This controls CORS — wrong value = orders will fail.
KITS_PUBLIC_SITE_URL=https://yourdomain.com

# ── WhatsApp number (international format, no + or spaces) ───
KITS_WHATSAPP=31643554052

# ── Shop settings ────────────────────────────────────────────
KITS_SEASON=25/26
KITS_FREE_SHIPPING_FROM=40
KITS_SHIPPING_COST=4.99
KITS_CUSTOM_PRINTING_PRICE=5

# ── Admin panel ──────────────────────────────────────────────
# REQUIRED on production (when KITS_PUBLIC_SITE_URL is not localhost):
# Generate:  php tools/set_admin_password.php "YourNewPassword"
# Paste the bcrypt hash here (16+ char password recommended).
KITS_ADMIN_EMAIL=your@email.com
KITS_ADMIN_PASSWORD_HASH=paste_bcrypt_hash_here

# Optional: only these IPs may open admin.php (comma-separated). Examples:
#   KITS_ADMIN_ALLOWED_IPS=203.0.113.44
#   KITS_ADMIN_ALLOWED_IPS=192.168.1.10,10.0.0.*
# Leave empty to allow from anywhere (rely on strong password + HTTPS).
KITS_ADMIN_ALLOWED_IPS=

# Only if behind a reverse proxy that sets X-Forwarded-For correctly (e.g. nginx, Cloudflare).
# KITS_TRUST_PROXY_FOR_IP=1

# ── Import/sync scripts (keep secret) ────────────────────────
# REQUIRED on production: long random string. Sync/import URLs return 403 if unset.
# Generate: php -r "echo bin2hex(random_bytes(24));"
KITS_IMPORT_SECRET=generate_a_long_random_string_here

# ── EmailJS ── Public key is sent to the browser by design; lock down abuse in EmailJS:
# Account → Security → Allowed domains: add your live domain (and localhost only for dev).
#
# ── EmailJS (public keys — restrict to your domain in EmailJS dashboard) ──
KITS_EMAILJS_PK=3dyna3NuBl7--nUZs
KITS_EMAILJS_SERVICE_ORDER=service_ekpmrrp
KITS_EMAILJS_SERVICE_RESTOCK=service_4ie7p0c
# Optional fallback (legacy): if *_ORDER / *_RESTOCK are not set, code falls back to KITS_EMAILJS_SERVICE
KITS_EMAILJS_SERVICE=
KITS_EMAILJS_TEMPLATE_ORDER=template_bb9p79e
KITS_EMAILJS_TEMPLATE_PAID=template_bb9p79e
KITS_EMAILJS_TEMPLATE_RESTOCK=template_zna2rkn
