# ============================================================
# KitsByElbaa — kopieer naar .env en vul in. Commit nooit .env.
# Alle variabelen: prefix KITS_ (zie config.php / kits_env).
# ============================================================

# ── Omgeving ───────────────────────────────────────────────
# local | production
KITS_ENV=local
# Alleen tijdelijk bij DB-problemen: KITS_DEBUG_DB=1 (api/healthz.php toont detail)

# ── Database ─────────────────────────────────────────────────
KITS_DB_HOST=127.0.0.1
KITS_DB_NAME=kitsbyelba
KITS_DB_USER=root
KITS_DB_PASS=
# Speciale tekens in wachtwoord? Gebruik dubbele quotes, bv. KITS_DB_PASS="pa$woord"

# ── Publieke URL & CORS ─────────────────────────────────────
# Geen slash aan het eind. Productlinks en e-mail gebruiken dit.
KITS_PUBLIC_SITE_URL=http://localhost/kitsbyelba
# Extra toegestane origins (komma), bv. https://www.jouwdomein.nl
KITS_TRUSTED_ORIGINS=
# Alleen 1 als je reverse proxy X-Forwarded-For betrouwbaar zet:
KITS_TRUST_PROXY_FOR_IP=

# ── Winkel / contact ───────────────────────────────────────
KITS_WHATSAPP=31684446255
KITS_SEASON=25/26
KITS_FREE_SHIPPING_FROM=40
KITS_SHIPPING_COST=4.99
KITS_CUSTOM_PRINTING_PRICE=5
# Meerprijs per shirt voor een gekozen badge/patch (naast naam/nummer-bedrukking)
KITS_BADGE_EXTRA_PRICE=3

# ── Admin (bcrypt alleen; geen plat wachtwoord) ──────────────
# tools/set_admin_password.php → plak hash hier
KITS_ADMIN_EMAIL=KitsByElbaa@outlook.com
KITS_ADMIN_PASSWORD_HASH=paste_bcrypt_hash_here
# Optioneel: IP-lock (komma), bv. 203.0.113.10,192.168.1.*
KITS_ADMIN_ALLOWED_IPS=
# BCC voor EmailJS (bestelling / nabestel). Leeg = standaard KitsByElbaa@outlook.com in code
KITS_NOTIFY_BCC=

# ── Import/sync (?secret= op scripts) ───────────────────────
KITS_IMPORT_SECRET=generate_a_long_random_string_here

# ── EmailJS (@emailjs/browser v4 + PHP REST na bestelling) ──
# Public Key: dashboard → Account (niet Service ID).
KITS_EMAILJS_PK=your_public_key_from_emailjs_account_page
# PHP stuurt mail via api.emailjs.com → dit MOET aan staan:
# https://dashboard.emailjs.com/admin/account/security
# → vink “Allow EmailJS API for non-browser applications” aan.
# Als Security “private key” verplicht: zet hier de private key (zelfde pagina):
# KITS_EMAILJS_ACCESS_TOKEN=
# Orderbevestiging: meestal “DEFAULT” Outlook-service in dashboard
KITS_EMAILJS_SERVICE_ORDER=service_k9yc1hs
# Nabestel / weer-op-voorraad: tweede service in dashboard
KITS_EMAILJS_SERVICE_RESTOCK=service_ldb3lbs
# Optioneel oud: alleen als je nog KITS_EMAILJS_SERVICE gebruikt zonder *_ORDER
# KITS_EMAILJS_SERVICE=
KITS_EMAILJS_TEMPLATE_ORDER=template_oue15bn
KITS_EMAILJS_TEMPLATE_PAID=template_oue15bn
KITS_EMAILJS_TEMPLATE_RESTOCK=template_9ugfrjb
